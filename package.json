{
  "name": "creditflow",
  "version": "1.0.0",
  "private": true,
  "description": "A Portofolio Project for Simple Credit System",
  "keywords": [],
  "homepage": "https://github.com/muhroyhan/creditflow#readme",
  "bugs": {
    "url": "https://github.com/muhroyhan/creditflow/issues"
  },
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhroyhan/creditflow.git"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "api:build": "pnpm --filter @creditflow/api build",
    "api:dev": "pnpm --filter @creditflow/api dev",
    "api:start": "pnpm --filter @creditflow/api start",
    "api:test": "pnpm --filter @creditflow/api test",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @creditflow/api generate",
    "db:migrate": "pnpm --filter @creditflow/api migrate",
    "db:up": "docker compose up -d",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm api:test && pnpm build",
    "web:build": "pnpm --filter @creditflow/web build",
    "web:dev": "pnpm --filter @creditflow/web dev",
    "web:start": "pnpm --filter @creditflow/web start"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.5.0+sha512.9cdbaa34ffacae1768635ac0d23e94db6201c7d59bf3da236b23d67c8f6b794d1dab323bcd5bcc51b55c8cafbf6f19a24e4aa61d6ab7772aa3b5cc85e325dc4d"
}
